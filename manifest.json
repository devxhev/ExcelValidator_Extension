{
  "manifest_version": 3,
  "name": "Excel Transformer Extension",
  "description": "Intercepts Excel downloads (blob and HTTP), processes them, and triggers a final download.",
  "version": "1.0.0",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "downloads",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "webRequest"
  ],

  "host_permissions": ["<all_urls>", "file://*"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["pageHook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
